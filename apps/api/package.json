{
  "name": "api",
  "version": "1.3.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --config .prettierrc --write \"src/**/*.ts\" \"../../test/api/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "NODE_ENV=production node dist/src/main.js",
    "lint": "cd ../.. && apps/api/node_modules/.bin/eslint --config apps/api/eslint.config.mjs \"apps/api/{src,apps,libs}/**/*.ts\" \"test/api/**/*.ts\" --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:console-context": "node ../../test/api/integration/console-context.integration.cjs",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:debug": "NODE_OPTIONS=--experimental-vm-modules node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "typeorm": "typeorm-ts-node-commonjs -d data-source.ts",
    "migration:generate": "bun run typeorm migration:generate src/database/migrations/Migration",
    "migration:run": "bun run typeorm migration:run",
    "migration:revert": "bun run typeorm migration:revert",
    "seed:run": "ts-node -r tsconfig-paths/register src/database/seeds/run-seeds.ts",
    "bootstrap:billing": "ts-node src/cli/bootstrap-billing.ts",
    "bootstrap:legal": "ts-node src/cli/bootstrap-legal.ts",
    "test:activation": "node --test ../../test/api/unit/activate-billing.test.mjs",
    "test:typecheck": "tsc --noEmit -p ../../test/tsconfig.json",
    "test:seed:docker": "bun run build && bash ../../test/api/integration/seed-access.docker.sh"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1116.0",
    "@hemia/event-bus": "0.0.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "^11.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "express": "5.2.1",
    "jose": "^6.1.3",
    "pg": "^8.21.0",
    "redis": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "../..",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "<rootDir>/apps/api/node_modules/ts-jest",
        {
          "tsconfig": "<rootDir>/test/tsconfig.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "apps/api/src/**/*.ts"
    ],
    "coverageDirectory": "<rootDir>/apps/api/coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test/api"
    ],
    "modulePaths": [
      "<rootDir>/apps/api/node_modules"
    ]
  }
}
