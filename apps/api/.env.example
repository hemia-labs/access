PORT=3019
AMQP_URL=
EVENT_BUS_ENABLED=false
EVENT_BUS_SERVICE_NAME=hemia-access
EVENT_BUS_PREFETCH=10
ACCESS_TRUSTED_ISSUERS=https://id.hemia.cloud
ACCESS_EXPECTED_AUDIENCE=access-api
ACCESS_ISSUER=https://access.hemia.cloud
ACCESS_CONTEXT_TOKEN_TTL_SECONDS=900
ACCESS_CONTEXT_CACHE_TTL_SECONDS=60
ACCESS_JWKS_KEY_KID=access-rs256
ACCESS_JWKS_PRIVATE_KEY_PATH=./secrets/access-jwks-private.pem
IDENTITY_JWKS_URI=http://localhost:4000/.well-known/jwks.json
IDENTITY_ISSUER=http://localhost:4000
IDENTITY_INTROSPECTION_URL=http://localhost:4000/oauth/introspect
IDENTITY_INTROSPECTION_CLIENT_ID=access
IDENTITY_INTROSPECTION_CLIENT_SECRET=
ACCESS_REDIS_HOST=
ACCESS_REDIS_PORT=6379
ACCESS_REDIS_USERNAME=
ACCESS_REDIS_PASSWORD=
ACCESS_REDIS_DB=0
ACCESS_REDIS_TLS=false
SEED_ADMIN_ISSUER=http://localhost:4000
SEED_ADMIN_SUBJECT_ID=seed-admin
SEED_ADMIN_EMAIL=admin@hemia.local
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_LOGGING=false

# Legal resource validation; dedicated OAuth client, no decision cache
LEGAL_VALIDATION_TOKEN_URL=http://localhost:4000/oauth/token
LEGAL_VALIDATION_URL=http://localhost:3017/v1/internal/authorization/targets/validate
LEGAL_VALIDATION_CLIENT_SECRET=

# Legal service identity authorized for consumer context
LEGAL_SERVICE_CLIENT_ID=legal-service-dev

# Invitations use SES v2 with AWS credentials from the environment.
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional, only for temporary AWS credentials
# AWS_SESSION_TOKEN=
EMAIL_PROJECT=hemia-access
EMAIL_ENVIRONMENT=dev
EMAIL_APP_NAME=Hemia
EMAIL_FROM_NAME=Hemia
EMAIL_FROM_AUTH=auth@hemia-access.hemia.dev
EMAIL_REPLY_TO=support@hemia.dev
EMAIL_SUPPORT_EMAIL=support@hemia.dev
EMAIL_CONFIGURATION_SET_AUTH=hemia-dev-auth
EMAIL_INVITATION_TEMPLATE=hemia-access-dev-invitation
ID_FRONTEND_URL=http://localhost:5173

EMAIL_WELCOME_TEMPLATE=hemia-access-dev-welcome
EMAIL_CONSOLE_URL=https://console.hemia.cloud
