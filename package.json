{
  "name": "nextjs-nestjs",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:api": "bun run --cwd apps/api start:dev",
    "test": "bun run --cwd apps/api test && bun run --cwd apps/api test:activation",
    "changeset": "changeset",
    "version:access": "node scripts/version-access.mjs",
    "test:release": "node --test test/release/*.test.mjs",
    "test:deploy": "python3 -m unittest discover -s test/deploy -p 'test_*.py'",
    "check": "bash scripts/access-checks.sh"
  },
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@changesets/cli": "2.31.1"
  }
}
