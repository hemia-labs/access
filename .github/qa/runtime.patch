diff --git a/apps/api/src/common/auth/identity-reference-issuer.ts b/apps/api/src/common/auth/identity-reference-issuer.ts
new file mode 100644
index 0000000..aafab39
--- /dev/null
+++ b/apps/api/src/common/auth/identity-reference-issuer.ts
@@ -0,0 +1,6 @@
+export function identityReferenceIssuer(issuer: string): string {
+  const directoryIssuer = process.env.IDENTITY_REFERENCE_ISSUER?.trim();
+  return directoryIssuer && issuer === process.env.IDENTITY_ISSUER
+    ? directoryIssuer
+    : issuer;
+}
